#cloud-config
autoinstall:
  version: 1
  source:
    id: ubuntu-server-minimal

  identity:
    hostname: ubuntu-docker
    username: sysadmin
    # Default password is 'changeme'. Change this before production!
    # Generate hash with: openssl passwd -6
    password: "$6$rounds=4096$FhW5L2.n2uQ3rGqG$g7Bsih1xy606vJfi68M0xgwR/fgPMo1PCWtxinwuT3ZJStjo.4LO4vQy0XB.9cf4teJBxTkX5ARYDxf7Adm8k/"

  network:
    version: 2
    ethernets:
      eth0:
        dhcp4: true

  ssh:
    install-server: true
    allow-pw: true

  packages:
    - openssh-server
    - ufw
    - iputils-ping
    - bind9-dnsutils
    - curl
    - wget
    - net-tools
    - htop
    - lsof
    - vim
    - unzip
    - docker.io
    - docker-compose-v2

  late-commands:
    - curtin in-target --target=/target -- ufw allow OpenSSH
    - curtin in-target --target=/target -- ufw --force enable
    - curtin in-target --target=/target -- usermod -aG docker sysadmin

  storage:
    layout:
      name: lvm
